# Virtual environment — huge, machine-specific, never commit
.venv/
venv/

# Raw data — 1.6GB has no business on GitHub
raw_data/

# Python auto-generated bytecode — not your code
__pycache__/
*.pyc
.pytest_cache/

# Secrets — NEVER commit these
.env
kaggle.json

# dbt build artifacts — auto-regenerated every run
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/

# macOS invisible file — not part of your project
.DS_Store

# Databricks Asset Bundle hidden folder (we will generate this soon)
.databricks/